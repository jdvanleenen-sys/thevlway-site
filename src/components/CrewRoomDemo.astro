---
const files = ['job-notes.md', 'price-book.md', 'quote-v1.docx', 'quote-v2.docx'];

const messages = [
  { who: 'Owner', ai: false, text: 'Measured the kitchen. 420 sq ft of walls, 2 coats. It is in job-notes.', file: 'job-notes.md' },
  { who: 'AI agent', ai: true, text: 'Read job-notes and the price book. Saved a draft quote.', file: 'quote-v1.docx' },
  { who: 'Office', ai: false, text: 'The customer wants the trim done too. Please add it.', file: 'quote-v1.docx' },
  { who: 'AI agent', ai: true, text: 'Added trim from the price book. Saved a new version.', file: 'quote-v2.docx' },
  { who: 'Estimator', ai: false, text: 'Trim price is right. Office, this one is good to send.', file: 'quote-v2.docx' },
];
---

<section class="demo-band">
  <div class="container">
    <h2>One job, one room</h2>
    <p class="sub">Watch a quote move through a shared room. The job and the people are made up.</p>
    <div class="room" data-crew-demo>
      <p class="room-bar"><strong>Quote: kitchen repaint</strong><span>3 people and 1 AI agent</span></p>
      <div class="room-body">
        <div class="files">
          <p class="files-title">Shared files</p>
          <ul>{files.map((file) => <li data-file={file}>{file}</li>)}</ul>
        </div>
        <ol class="chat">
          {
            messages.map((message) => (
              <li class:list={['message', { ai: message.ai }]} data-uses={message.file}>
                <strong>{message.who}</strong>
                <span>{message.text}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .demo-band {
    padding: var(--space-7) 0;
    background: var(--cream);
  }

  h2 {
    margin-bottom: var(--space-2);
  }

  .sub {
    margin-bottom: var(--space-5);
  }

  .room {
    background: var(--white);
    border: 3px solid var(--edubaware);
  }

  .room-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--edubaware);
    color: var(--white);
    font-size: 1rem;
  }

  .room-body {
    display: grid;
    grid-template-columns: minmax(170px, 1fr) minmax(0, 3fr);
  }

  .files {
    padding: var(--space-4);
    background: var(--warm-white);
    border-right: 2px solid var(--cream);
  }

  .files-title {
    margin-bottom: var(--space-2);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .files ul {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .files li {
    padding: var(--space-1) var(--space-2);
    border-left: 3px solid transparent;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
    transition: background 0.25s, border-color 0.25s;
  }

  .files li:global(.active) {
    border-left-color: var(--edubaware);
    background: var(--cognac-light);
    font-weight: 700;
  }

  .chat {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-4);
    list-style: none;
  }

  .message {
    display: grid;
    gap: 2px;
    max-width: 85%;
    padding: var(--space-2) var(--space-3);
    background: var(--warm-white);
    border: 2px solid var(--navy);
    font-size: 1rem;
    line-height: 1.4;
    transition: opacity 0.35s, transform 0.35s;
  }

  .message.ai {
    justify-self: end;
    border-color: var(--edubaware);
    background: var(--cognac-light);
  }

  .message.ai strong {
    color: var(--edubaware);
  }

  .message:global(.waiting) {
    opacity: 0;
    transform: translateY(8px);
  }

  @media (max-width: 720px) {
    .room-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .files {
      border-right: 0;
      border-bottom: 2px solid var(--cream);
    }

    .files ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .message {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .files li,
    .message {
      transition: none;
    }
  }
</style>

<script>
  const STEP_MS = 2200;
  const HOLD_STEPS = 3;

  function playCrewDemo(room: HTMLElement) {
    const messages = [...room.querySelectorAll<HTMLElement>('.message')];
    const files = [...room.querySelectorAll<HTMLElement>('[data-file]')];
    let step = 1;

    const show = () => {
      const shown = Math.min(step, messages.length);
      messages.forEach((message, index) => message.classList.toggle('waiting', index >= shown));
      const current = shown > 0 ? messages[shown - 1].dataset.uses : undefined;
      files.forEach((file) => file.classList.toggle('active', file.dataset.file === current));
      step = step >= messages.length + HOLD_STEPS ? 1 : step + 1;
    };

    show();
    window.setInterval(show, STEP_MS);
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-crew-demo]').forEach(playCrewDemo);
  }
</script>
