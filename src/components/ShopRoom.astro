---
import ShopScene, { type SceneName } from './ShopScene.astro';

interface Props {
  plate: string;
  scene: SceneName;
  alt: string;
  title: string;
  layout: 'side' | 'free' | 'paid' | 'full';
  href?: string;
  action?: string;
}

const { plate, scene, alt, title, layout, href, action } = Astro.props;
---

<article class:list={['room', 'depth-box', layout]}>
  <p class="plate">{plate}</p>
  <div class="inner">
    <div class="picture"><ShopScene name={scene} alt={alt} /></div>
    <div class="body">
      <h3>{title}</h3>
      <slot />
      {
        href && action && (
          <a class:list={layout === 'paid' || layout === 'full' ? 'button door-button paid-button' : 'action'} href={href}>
            {action}
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .room {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--white);
    border: 3px solid var(--navy);
  }

  /* Free and paid sit in ShopRooms' .doors-pair, which sizes them so both pictures share one height. */
  .paid {
    --depth-edge: var(--edubaware-dark);
  }

  .side {
    grid-column: span 6;
  }

  /* Sits above the 4 side rooms at every width, and below the 2 doors on desktop. */
  .full {
    --depth-edge: var(--edubaware-dark);
    grid-column: 1 / -1;
    order: -1;
    border-color: var(--edubaware);
  }

  .plate {
    margin: 0;
    padding: var(--space-2) var(--space-4);
    background: var(--navy);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .paid .plate,
  .full .plate {
    background: var(--edubaware);
  }

  .inner {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .side .inner,
  .full .inner {
    flex-direction: row;
  }

  .picture {
    display: block;
    width: 100%;
    border-bottom: 3px solid var(--navy);
  }

  .side .picture {
    flex: 0 0 48%;
    width: 48%;
    align-self: center;
    border-bottom: 0;
    border-right: 3px solid var(--navy);
  }

  .full .picture {
    flex: 0 0 58%;
    width: 58%;
    align-self: center;
    border-bottom: 0;
    border-right: 3px solid var(--edubaware);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-4);
  }

  h3 {
    margin-bottom: var(--space-2);
    font-size: 1.4rem;
  }

  .body :global(.room-copy) {
    margin-bottom: var(--space-3);
    font-size: 1rem;
    line-height: 1.5;
  }

  .action {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 44px;
    margin-top: auto;
    color: var(--cognac-dark);
    font-weight: 700;
  }

  .paid-button {
    margin-top: auto;
    border-color: var(--edubaware);
    background: var(--edubaware);
    color: var(--white);
  }

  .paid-button:hover {
    border-color: var(--edubaware-dark);
    background: var(--edubaware-dark);
    color: var(--white);
  }

  @media (max-width: 980px) {
    .side {
      grid-column: span 12;
    }
  }

  @media (max-width: 980px) {
    .full .inner {
      flex-direction: column;
    }

    .full .picture {
      flex: none;
      width: 100%;
      border-right: 0;
      border-bottom: 3px solid var(--edubaware);
    }
  }

  @media (max-width: 620px) {
    .side .inner {
      flex-direction: column;
    }

    .side .picture {
      flex: none;
      width: 100%;
      border-right: 0;
      border-bottom: 3px solid var(--navy);
    }
  }
</style>
