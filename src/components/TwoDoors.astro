---
import AffiliateLink from './AffiliateLink.astro';
import { EDUBAWARE_FOUNDING_SEATS_START, EDUBAWARE_FREE_URL, EDUBAWARE_PAGE_URL, EDUBAWARE_PRICE } from '../consts';
---

<section class="two-doors" aria-label="Two ways to learn this">
  <article class="door depth-box">
    <p class="door-name">Free</p>
    <p>Two short lessons on your own weekly job, with an AI coach in EdubaWare, a website where people and AI work in the same chat and share folders.</p>
    <p class="disclosure">Email the word FREE to get in.</p>
    <a class="button button-primary door-button" href={EDUBAWARE_FREE_URL}>Start free</a>
  </article>

  <article class="door paid depth-box">
    <p class="door-name">Paid</p>
    <p>Build your weekly job in my school, AI the vL Way, with me in the chat. Bring your crew, and you all work in the same chat at the same time.</p>
    <p class="disclosure">{EDUBAWARE_PRICE} per person, per month. {EDUBAWARE_FOUNDING_SEATS_START} founding seats, by invitation.</p>
    <a class="button button-secondary door-button" href={EDUBAWARE_PAGE_URL}>See the EdubaWare school</a>
  </article>

  <article class="door source depth-box">
    <p class="door-name">Learn from the source</p>
    <AffiliateLink fillCard />
  </article>
</section>

<style>
  .two-doors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-4);
  }

  .door {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--white);
    border: 1px solid rgba(107, 101, 96, 0.3);
    border-top: 4px solid var(--cognac);
    border-radius: 6px;
  }

  .door-name {
    margin-bottom: var(--space-2);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .disclosure {
    margin-top: auto;
    margin-bottom: var(--space-2);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .paid {
    --depth-edge: var(--edubaware-dark);
    border-top-color: var(--edubaware);
  }

  .paid .door-name {
    color: var(--edubaware);
  }

  .paid .button {
    border-color: var(--edubaware);
    background: var(--edubaware);
    color: var(--white);
  }

  .paid .button:hover {
    border-color: var(--edubaware-dark);
    background: var(--edubaware-dark);
  }

  .door .button {
    text-align: center;
  }

  .source {
    grid-column: 1 / -1;
  }
</style>
