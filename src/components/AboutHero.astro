---
import ShopScene from './ShopScene.astro';
import { OWNER_AUTHORITY, OWNER_NAME } from '../consts';
---

<section class="container hero">
  <div class="intro">
    <p class="eyebrow">About {OWNER_NAME}</p>
    <h1>The subject changes. The teacher doesn't.</h1>
    <p class="lede">{OWNER_AUTHORITY}</p>
    <p class="home">
      I know the new home business from the inside, so I can find your pain points and solve them
      with you.
    </p>
  </div>
  <div class="scene">
    <ShopScene
      name="office"
      alt="Jeff in a hard hat at his office desk with an apple and a clipboard, under house plans and a small chalkboard, while Bit walks past."
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-6);
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }

  .intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--cognac-dark);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .lede {
    font-size: 1.2rem;
    font-weight: 500;
  }

  .home {
    margin-bottom: 0;
  }

  .scene {
    align-self: center;
    min-width: 0;
    border: 4px solid var(--navy);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-top: var(--space-6);
    }
  }
</style>
