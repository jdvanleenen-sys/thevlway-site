---
import {
  CONTACT_EMAIL,
  EDUBAWARE_INVITE_URL,
  EDUBAWARE_PRICE,
  EDUBAWARE_REFUND_DAYS,
  OWNER_LOCATION,
  OWNER_NAME,
  SITE_NAME,
} from '../consts';

const included = [
  'Your own workspace in EdubaWare, where an AI agent walks you through each lesson.',
  'Short lessons in plain words, for people who are not technical.',
  'Practice on one task you repeat every week, so what you build is useful at work.',
  'New lessons as they are finished. The first lessons are open now.',
  '2 or more paid seats get 1 private shared room for your crew.',
];

const steps = [
  { title: 'Email me', line: `Send the word INVITE to ${CONTACT_EMAIL}.` },
  { title: 'Get the payment link', line: 'I reply with a secure Stripe checkout link.' },
  { title: 'Pay by card', line: `${EDUBAWARE_PRICE} per person, billed monthly.` },
  { title: 'Get your invitation', line: 'I send the EdubaWare invitation to the email you used at checkout.' },
];

const limits = [
  'EdubaWare is in early testing, so its screens and features will change.',
  'When someone works in another chat, refresh the page to see their new files.',
  'There is no undo for files yet. If 2 people change the same sentence at once, the last change wins.',
  'Everyone in a room can read and download every file in it. Keep passwords and private customer details out.',
];
---

<section class="container terms">
  <div class="panels two">
    <article class="panel">
      <h2>What you get</h2>
      <ul>{included.map((item) => <li>{item}</li>)}</ul>
    </article>
    <article class="panel">
      <h2>How to join</h2>
      <ol>
        {
          steps.map((step) => (
            <li>
              <strong>{step.title}.</strong> {step.line}
            </li>
          ))
        }
      </ol>
      <a class="button door-button invite" href={EDUBAWARE_INVITE_URL}>Email me for an invitation</a>
    </article>
  </div>

  <div class="panels one">
    <article class="panel">
      <h2>Know this before you join</h2>
      <ul class="limits">{limits.map((item) => <li>{item}</li>)}</ul>
      <p class="seen">
        I can see your workspace and chats so I can teach and check your work. Other managers of the
        same EdubaWare organization can see them too. Read the <a href="/privacy/">privacy policy</a>.
      </p>
    </article>
  </div>

  <div class="panels three">
    <article class="panel">
      <h2>Who you are buying from</h2>
      <p>
        You are buying from {OWNER_NAME} of {SITE_NAME}, based in {OWNER_LOCATION}. I am one of Jake
        Van Clief's 7 Masters of ICM, and this school uses ICM Principles by Jake Van Clief. Eduba runs
        the EdubaWare platform. I run this school on it and handle your billing. Your card statement
        will show EDUBAWARE.
      </p>
    </article>
    <article class="panel">
      <h2 id="refunds">Cancellations and refunds</h2>
      <p>
        To cancel, email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Your next charge
        stops and you keep access until the end of the month you paid for.
      </p>
      <p>
        If it is not for you, email me within {EDUBAWARE_REFUND_DAYS} days of your first payment for a
        full refund. Later payments and partial months are not refunded.
      </p>
    </article>
    <article class="panel">
      <h2>Payment and questions</h2>
      <p>
        Stripe processes all card payments, so your card number never reaches me. For anything else,
        email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </article>
  </div>
</section>

<style>
  .terms {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .panels {
    display: grid;
    gap: var(--space-4);
  }

  .two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-4);
    background: var(--white);
    border: 2px solid var(--navy);
    border-top: 6px solid var(--edubaware);
    font-size: 1rem;
    line-height: 1.5;
  }

  h2 {
    margin-bottom: var(--space-3);
    color: var(--edubaware);
    font-size: 1.4rem;
  }

  ul,
  ol {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  li {
    margin-bottom: var(--space-2);
  }

  .limits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-6);
  }

  .panel p:last-child,
  .panel ul:last-child {
    margin-bottom: 0;
  }

  a {
    overflow-wrap: anywhere;
  }

  .invite {
    margin-top: auto;
    border-color: var(--edubaware);
    background: var(--edubaware);
    color: var(--white);
  }

  .invite:hover {
    border-color: var(--edubaware-dark);
    background: var(--edubaware-dark);
    color: var(--white);
  }

  @media (max-width: 860px) {
    .two,
    .three,
    .limits {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
