---
import {
  CONTACT_EMAIL,
  EDUBAWARE_FREE_URL,
  EDUBAWARE_INVITE_URL,
  EDUBAWARE_PRICE,
  EDUBAWARE_REFUND_DAYS,
  OWNER_LOCATION,
  OWNER_NAME,
  SITE_NAME,
} from '../consts';

const steps = [
  { title: 'Email me', line: `Send the word INVITE to ${CONTACT_EMAIL}.` },
  { title: 'Get the payment link', line: 'I reply with a secure Stripe checkout link.' },
  { title: 'Pay by card', line: `${EDUBAWARE_PRICE} per person, billed monthly.` },
  { title: 'Get your invitation', line: 'I send the EdubaWare invitation to the email you used at checkout.' },
];

const limits = [
  'EdubaWare is in early testing, so its screens and features will change.',
  'Everyone in the same chat sees it live. If someone is working in a different chat, refresh the page to see their new files.',
  'Anyone in a shared room can change or delete a file, and there is no undo yet. If two people change the same sentence at once, the last change wins.',
  'Everyone in a shared room can read and download every file in it. Keep passwords and private customer details out, and practise with made-up or blanked-out customer details.',
];
---

<section class="container terms" id="join">
  <div class="panels two">
    <article class="panel depth-box">
      <h2>How to join</h2>
      <ol>
        {
          steps.map((step) => (
            <li>
              <strong>{step.title}.</strong> {step.line}
            </li>
          ))
        }
      </ol>
      <p class="free">Want the free lessons first? <a href={EDUBAWARE_FREE_URL}>Email me the word FREE</a>.</p>
      <a class="button button-edubaware door-button invite" href={EDUBAWARE_INVITE_URL}>Ask for a founding seat</a>
    </article>
    <article class="panel depth-box">
      <h2>Know this before you join</h2>
      <ul>{limits.map((item) => <li>{item}</li>)}</ul>
      <p class="seen">
        I can see your workspace and chats so I can teach and check your work. Other managers of the
        same EdubaWare organization can see them too. Read the <a href="/privacy/">privacy policy</a>.
      </p>
    </article>
  </div>

  <div class="panels three">
    <article class="panel depth-box">
      <h2>Who you are buying from</h2>
      <p>
        You are buying from {OWNER_NAME} of {SITE_NAME}, based in {OWNER_LOCATION}. I am one of Jake
        Van Clief's 7 Masters of ICM, and this school uses ICM Principles by Jake Van Clief. Eduba runs
        the EdubaWare platform. I run this school on it and handle your billing. Your card statement
        will show EDUBAWARE.
      </p>
    </article>
    <article class="panel depth-box">
      <h2 id="refunds">Cancellations and refunds</h2>
      <p>
        To cancel, email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Your next charge
        stops and you keep access until the end of the month you paid for. Download your files before your access ends.
      </p>
      <p>
        If it is not for you, email me within {EDUBAWARE_REFUND_DAYS} days of your first payment for a
        full refund. When the last three lessons open, founding members get another {EDUBAWARE_REFUND_DAYS} days
        to ask for a refund of their latest monthly payment. Other payments and partial months are not refunded.
      </p>
    </article>
    <article class="panel depth-box">
      <h2>Payment and questions</h2>
      <p>
        Stripe processes all card payments, so your full card number never reaches me. For anything else,
        email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </article>
  </div>
</section>

<style>
  .terms {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .panels {
    display: grid;
    gap: var(--space-4);
  }

  .two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-4);
    background: var(--white);
    border: 2px solid var(--navy);
    border-top: 6px solid var(--edubaware);
    font-size: 1rem;
    line-height: 1.5;
  }

  h2 {
    margin-bottom: var(--space-3);
    color: var(--edubaware);
    font-size: 1.4rem;
  }

  ul,
  ol {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  li {
    margin-bottom: var(--space-2);
  }

  .panel p:last-child,
  .panel ul:last-child {
    margin-bottom: 0;
  }

  a {
    overflow-wrap: anywhere;
  }

  .invite {
    margin-top: auto;
  }

  @media (max-width: 860px) {
    .two,
    .three {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
