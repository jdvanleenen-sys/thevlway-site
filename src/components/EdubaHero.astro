---
import ShopScene from './ShopScene.astro';
import {
  ICM_PLAIN,
  CONTACT_EMAIL,
  EDUBAWARE_FOUNDING_SEATS,
  EDUBAWARE_FOUNDING_SEATS_START,
  EDUBAWARE_FREE_URL,
  EDUBAWARE_INVITE_URL,
  EDUBAWARE_PRICE,
  OWNER_NAME,
} from '../consts';
---

<section class="container hero">
  <div class="intro">
    <p class="eyebrow">ICM Principles by Jake Van Clief</p>
    <h1>Bring one weekly job. Build it with a teacher in the same chat.</h1>
    <p class="lede">
      Not technical and not sure where to start with AI? Bring one job you repeat every week. You, an AI
      coach and a real teacher work on it in the same chat. No coding.
    </p>
    <p class="credit">
      I'm {OWNER_NAME}, one of Jake Van Clief's 7 Masters of ICM, and a teacher for over 24 years. {ICM_PLAIN}
    </p>
  </div>
  <div class="scene">
    <ShopScene
      name="aibench"
      alt="Jeff at a desk with a laptop and a board of folders, working with Bip and Bit."
    />
  </div>
  <div class="doors">
    <article class="door depth-box">
      <p class="door-name">Try it</p>
      <p class="price">Free</p>
      <p class="note">Two short lessons on your own weekly job. Free lessons are with the AI coach. A founding seat adds me to your chat.</p>
      <a class="button button-edubaware door-button invite" href={EDUBAWARE_FREE_URL}>Start free</a>
      <p class="small">Send the word FREE to {CONTACT_EMAIL}.</p>
    </article>
    <article class="door depth-box">
      <p class="door-name">Build it with me</p>
      <p class="price">{EDUBAWARE_PRICE}</p>
      <p class="note">
        Per person, per month. {EDUBAWARE_FOUNDING_SEATS_START} founding seats. Cancel any time. The first
        four lessons are open. I finish the last three with the first group.
      </p>
      <a class="button button-edubaware door-button invite" href={EDUBAWARE_INVITE_URL}>Ask for a founding seat</a>
      <p class="small">Send the word INVITE to {CONTACT_EMAIL}.</p>
    </article>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-6);
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }

  .intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--edubaware);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h1 {
    color: var(--edubaware);
    font-size: clamp(2rem, 3.8vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .lede {
    margin-bottom: var(--space-4);
    font-size: 1.15rem;
  }

  .credit {
    margin-bottom: 0;
    padding-left: var(--space-3);
    border-left: 4px solid var(--edubaware);
    font-size: 1rem;
  }

  .scene {
    align-self: center;
    min-width: 0;
    border: 4px solid var(--edubaware);
  }

  .doors {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .door {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-4);
    background: var(--white);
    border: 3px solid var(--edubaware);
  }

  .door-name {
    margin-bottom: var(--space-1);
    color: var(--edubaware);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .price {
    margin: 0;
    color: var(--edubaware);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .note {
    margin-bottom: var(--space-3);
    font-size: 1rem;
    line-height: 1.45;
  }

  .invite {
    margin-top: auto;
  }

  .small {
    margin: var(--space-2) 0 0;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-top: var(--space-5);
    }

    .doors {
      order: 1;
    }

    .scene {
      order: 2;
    }
  }

  @media (max-width: 620px) {
    .doors {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 400px) {
    .hero {
      gap: var(--space-4);
      padding-top: var(--space-4);
    }

    h1 {
      font-size: 1.6rem;
    }

    .lede {
      margin-bottom: var(--space-3);
      font-size: 1rem;
    }

    .credit {
      font-size: 0.9rem;
    }
  }
</style>
