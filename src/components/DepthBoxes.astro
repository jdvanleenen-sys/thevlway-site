---
// Gives every .depth-box on the site a solid edge that shifts with the mouse.
// The box moves in whole pixels and never rotates, because rotating blurs its text.
// A page or box can set --depth-edge to change the edge colour.
---

<style is:global>
  :where(.depth-box) {
    position: relative;
  }

  .depth-box.depth-box {
    --sx: 1px;
    --sy: 1px;
    --edge: var(--depth-edge, var(--navy-dark));
    box-shadow:
      calc(var(--sx) * 1) calc(var(--sy) * 1) 0 var(--edge),
      calc(var(--sx) * 2) calc(var(--sy) * 2) 0 var(--edge),
      calc(var(--sx) * 3) calc(var(--sy) * 3) 0 var(--edge),
      calc(var(--sx) * 4) calc(var(--sy) * 4) 0 var(--edge),
      calc(var(--sx) * 5) calc(var(--sy) * 5) 0 var(--edge),
      calc(var(--sx) * 6) calc(var(--sy) * 6) 0 var(--edge),
      calc(var(--sx) * 7) calc(var(--sy) * 7) 0 var(--edge),
      calc(var(--sx) * 8) calc(var(--sy) * 8) 0 var(--edge);
    transition: box-shadow 0.12s ease-out, background 0.2s ease-out;
  }

  .depth-box.is-tilting {
    z-index: 2;
    translate: var(--shift-x, 0px) var(--shift-y, 0px);
  }

  @media (prefers-reduced-motion: reduce) {
    .depth-box.depth-box {
      transition: none;
    }
  }
</style>

<script>
  const MAX_SHIFT_PIXELS = 3;
  const EDGE_SWING = 1.4;
  const TILT_PROPERTIES = ['--sx', '--sy', '--shift-x', '--shift-y'];

  function addTilt(box: HTMLElement) {
    box.addEventListener('pointermove', (event) => {
      // Measure without the current shift so the box does not jitter under the mouse.
      const rect = box.getBoundingClientRect();
      const shiftX = parseInt(box.style.getPropertyValue('--shift-x'), 10) || 0;
      const shiftY = parseInt(box.style.getPropertyValue('--shift-y'), 10) || 0;
      const x = Math.max(-0.5, Math.min(0.5, (event.clientX - rect.left + shiftX) / rect.width - 0.5));
      const y = Math.max(-0.5, Math.min(0.5, (event.clientY - rect.top + shiftY) / rect.height - 0.5));
      box.classList.add('is-tilting');
      box.style.setProperty('--sx', `${(1 - x * EDGE_SWING).toFixed(2)}px`);
      box.style.setProperty('--sy', `${(1 - y * EDGE_SWING).toFixed(2)}px`);
      box.style.setProperty('--shift-x', `${Math.round(x * 2 * MAX_SHIFT_PIXELS)}px`);
      box.style.setProperty('--shift-y', `${Math.round(y * 2 * MAX_SHIFT_PIXELS)}px`);
    });

    box.addEventListener('pointerleave', () => {
      box.classList.remove('is-tilting');
      TILT_PROPERTIES.forEach((name) => box.style.removeProperty(name));
    });
  }

  if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('.depth-box').forEach(addTilt);
  }
</script>
