---
import AffiliateLink from './AffiliateLink.astro';
import ShopRoom from './ShopRoom.astro';
import { OWNER_AUTHORITY, EDUBAWARE_FOUNDING_SEATS_START, EDUBAWARE_PAGE_URL, EDUBAWARE_PRICE, TEAMS_PATH, TEAMS_PRICE, YOUTUBE_URL } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const postCount = (await getPublishedPosts()).length;
---

<section class="rooms">
  <div class="shop-wrap">
    <h2>Walk around the shop</h2>
    <div class="floor">
      <ShopRoom
        layout="side"
        plate="Screening room"
        scene="screening"
        alt="Bip looks worried on a movie screen while three people watch from the seats."
        title="Watch Bip get it wrong."
        href={YOUTUBE_URL}
        action="Watch on YouTube"
      >
        <p class="room-copy">Bip is our robot intern. These videos show what goes wrong in everyday office work, and how to fix it.</p>
      </ShopRoom>
      <ShopRoom
        layout="side"
        plate="Library"
        scene="library"
        alt="Bip beside a tall bookshelf while a member reads in an armchair."
        title="Read it in plain words."
        href="/blog/"
        action="Read the blog"
      >
        <p class="room-copy">{postCount} posts on quotes, systems and which problem to fix first.</p>
      </ShopRoom>
      <div class="doors-pair">
      <ShopRoom
        layout="free"
        plate="Front desk: Clief Notes, free"
        scene="frontdesk"
        alt="Bit behind a front desk under a Clief Notes sign and a framed poster of the Clief Notes emblem, a drawing of Jake Van Clief, with a customer walking up."
        title="Meet the source."
      >
        <AffiliateLink fillCard />
      </ShopRoom>
      <ShopRoom
        layout="paid"
        plate="Classroom: EdubaWare, paid"
        scene="classroom"
        alt="Bip teaches at a chalkboard that says one task while three owners work at desks."
        title="Build your weekly task with me."
        href={EDUBAWARE_PAGE_URL}
        action="See the EdubaWare school"
      >
        <p class="room-copy">
          My school runs on EdubaWare. You get your own workspace, short lessons in plain words, an AI
          coach, and me in the same chat when you get stuck. The first four lessons are open. I am
          finishing the last three with the first group.
        </p>
        <p class="room-copy"><strong>{EDUBAWARE_PRICE} per person, per month. {EDUBAWARE_FOUNDING_SEATS_START} founding seats, by invitation.</strong></p>
      </ShopRoom>
      </div>
      <ShopRoom
        layout="side"
        plate="Break room"
        scene="breakroom"
        alt="A painter plays an arcade game in a break room with a coffee machine and fridge."
        title="Give Bip a shift."
        href="/play/"
        action="Play Robo-Intern"
      >
        <p class="room-copy">Robo-Intern is the game where Bip and Bit got their start.</p>
      </ShopRoom>
      <ShopRoom
        layout="side"
        plate="Office"
        scene="office"
        alt="Jeff in a hard hat at a desk with an apple, under house plans on the wall."
        title="Meet Jeff."
        href="/about/"
        action="Read about Jeff"
      >
        <p class="room-copy">{OWNER_AUTHORITY}</p>
      </ShopRoom>
      <ShopRoom
        layout="full"
        plate="Boardroom: EdubaWare, for teams"
        scene="teamroom"
        alt="Four people sit at a long burgundy table with a laptop and coffee, under a One Room sign and a board of three linked folders, while Bip stands at the end of the table."
        title="Finish the job together."
        href={TEAMS_PATH}
        action="See AI the vL Way for Teams"
      >
        <p class="room-copy">Your departments finish their work together in shared EdubaWare chats, with templates made for the different jobs your company runs.</p>
        <p class="room-copy"><strong>{TEAMS_PRICE} per seat, per month.</strong></p>
      </ShopRoom>
    </div>
  </div>
</section>

<style>
  .rooms {
    padding: var(--space-7) 0;
    background: var(--cream);
  }

  .shop-wrap {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: var(--space-7);
    padding-right: var(--space-7);
  }

  h2 {
    margin-bottom: var(--space-5);
  }

  .floor {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4);
  }

  /* The front desk art is 160 wide and the classroom art 240, so the space inside the two cards
     splits 2 to 3. Both pictures get the same height and both cards start their text on the same
     line. The 6px is each card's left and right border, kept out of the split. */
  .doors-pair {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: calc((100% - var(--space-4) - 12px) * 2 / 5 + 6px) minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 981px) {
    .doors-pair {
      order: -1;
    }
  }

  @media (max-width: 980px) {
    .doors-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 620px) {
    .shop-wrap {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
  }
</style>
