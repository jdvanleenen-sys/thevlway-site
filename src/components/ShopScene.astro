---
const SCENES = {
  hero: { w: 240, h: 135, floor: 106, dark: false },
  classroom: { w: 240, h: 110, floor: 86, dark: false },
  frontdesk: { w: 160, h: 110, floor: 88, dark: false },
  screening: { w: 160, h: 110, floor: 78, dark: true },
  library: { w: 160, h: 110, floor: 92, dark: false },
  breakroom: { w: 160, h: 110, floor: 88, dark: false },
  office: { w: 160, h: 110, floor: 88, dark: false },
  teamroom: { w: 240, h: 135, floor: 104, dark: false },
} as const;

export type SceneName = keyof typeof SCENES;

const MOTION: Record<SceneName, string> = {
  hero: '--beat:2.8s;--offset:0.2s;--sway:6s;--sway-delay:-1s;--roam:12s;--roam-delay:0s;',
  classroom: '--beat:3.4s;--offset:1.1s;--sway:7.3s;--sway-delay:-4.2s;--roam:15s;--roam-delay:-6s;',
  frontdesk: '--beat:2.6s;--offset:0.7s;--sway:5.4s;--sway-delay:-2.3s;--roam:11s;--roam-delay:-2s;',
  screening: '--beat:3.8s;--offset:1.9s;--sway:8.1s;--sway-delay:-6s;--roam:13s;--roam-delay:0s;',
  library: '--beat:4.2s;--offset:2.4s;--sway:6.7s;--sway-delay:-3.1s;--roam:17s;--roam-delay:-9s;',
  breakroom: '--beat:2.4s;--offset:1.4s;--sway:5.9s;--sway-delay:-5s;--roam:10s;--roam-delay:-4s;',
  office: '--beat:3.6s;--offset:0.4s;--sway:7.7s;--sway-delay:-1.8s;--roam:14s;--roam-delay:-11s;',
  teamroom: '--beat:3s;--offset:0.9s;--sway:6.4s;--sway-delay:-2.7s;--roam:13s;--roam-delay:-3s;',
};

interface Props {
  name: SceneName;
  alt: string;
}

const { name, alt } = Astro.props;
const scene = SCENES[name];
const hasRoamer = name !== 'hero' && name !== 'screening';
const sceneVars = `--w:${scene.w};--h:${scene.h};--f:${scene.floor};--back:url('/shop/${name}-back.png');${MOTION[name]}`;
---

<div class:list={['diorama', { dark: scene.dark }]} role="img" aria-label={alt} style={sceneVars}>
  <div class="camera">
    <div class="sway">
      <div class="stage" data-tilt>
        <div class="plane ceiling"></div>
        <div class="plane side left"></div>
        <div class="plane side right"></div>
        <div class="plane back"></div>
        <div class="plane ground"></div>
      </div>
    </div>
    <div class="sway">
      <div class="stage" data-tilt>
        {
          [0, 1, 2, 3].map((frame) => (
            <img
              class:list={['front', `frame-${frame}`]}
              style={`--frame:${frame};`}
              src={`/shop/${name}-front-${frame}.png`}
              alt=""
              width={scene.w * 4}
              height={scene.h * 4}
            />
          ))
        }
        {hasRoamer && <img class="roamer" src="/shop/bit-walk.png" alt="" width="40" height="56" />}
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .diorama {
    position: relative;
    width: 100%;
    aspect-ratio: var(--w) / var(--h);
    overflow: hidden;
    container-type: inline-size;
    background: var(--navy);
  }

  .camera {
    --u: calc(100cqw / var(--w));
    --d: calc(var(--u) * 30);
    --reach: calc(var(--u) * 90);
    position: absolute;
    inset: 0;
    perspective: calc(var(--u) * 260);
    perspective-origin: 50% 28%;
  }

  .sway,
  .stage {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .sway {
    animation: sway var(--sway) ease-in-out var(--sway-delay) infinite alternate;
  }

  .stage {
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.25s ease-out;
  }

  .plane {
    position: absolute;
    image-rendering: pixelated;
  }

  .back {
    top: 0;
    left: 0;
    width: 100%;
    height: calc(var(--u) * var(--f));
    background: var(--back) top / 100% calc(var(--u) * var(--h)) no-repeat;
    transform: translateZ(calc(var(--d) * -1));
  }

  .ground {
    top: calc(var(--u) * var(--f));
    left: 0;
    width: 100%;
    height: calc(var(--d) + var(--reach));
    background: var(--back) bottom / 100% calc((var(--d) + var(--reach)) * var(--h) / (var(--h) - var(--f))) no-repeat;
    transform-origin: top;
    transform: translateZ(calc(var(--d) * -1)) rotateX(90deg);
  }

  .side {
    top: 0;
    width: calc(var(--d) + var(--reach));
    height: calc(var(--u) * var(--f));
    background: linear-gradient(
      to top,
      var(--navy) 0 var(--u),
      var(--white) 0 calc(var(--u) * 3),
      var(--cream) 0 calc(var(--u) * 16),
      var(--cognac-dark) 0 calc(var(--u) * 17),
      var(--cream) 0
    );
  }

  .left {
    left: 0;
    transform-origin: left;
    transform: translateZ(calc(var(--d) * -1)) rotateY(-90deg);
  }

  .right {
    right: 0;
    transform-origin: right;
    transform: translateZ(calc(var(--d) * -1)) rotateY(90deg);
  }

  .ceiling {
    top: 0;
    left: 0;
    width: 100%;
    height: calc(var(--d) + var(--reach));
    background: var(--cognac-dark);
    transform-origin: top;
    transform: translateZ(calc(var(--d) * -1)) rotateX(-90deg);
  }

  .dark .side {
    background: var(--navy-dark);
  }

  .dark .ceiling {
    background: var(--navy);
  }

  .front {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    image-rendering: pixelated;
    opacity: 0;
    transform: translateZ(calc(var(--u) * 12));
    animation: frame-cycle var(--beat) step-end infinite;
    animation-delay: calc(var(--beat) * (var(--frame) / 4 - 1) - var(--offset));
  }

  .roamer {
    position: absolute;
    bottom: calc(var(--u) * 5);
    left: 14%;
    width: calc(var(--u) * 10);
    height: auto;
    max-width: none;
    image-rendering: pixelated;
    animation: roam var(--roam) steps(22) var(--roam-delay) infinite;
  }

  @keyframes frame-cycle {
    0% {
      opacity: 1;
    }
    25%,
    100% {
      opacity: 0;
    }
  }

  @keyframes roam {
    0% {
      left: 14%;
      transform: translateZ(calc(var(--u) * 20)) scaleX(1);
    }
    46% {
      left: 74%;
      transform: translateZ(calc(var(--u) * 20)) scaleX(1);
    }
    50% {
      left: 74%;
      transform: translateZ(calc(var(--u) * 20)) scaleX(-1);
    }
    96% {
      left: 14%;
      transform: translateZ(calc(var(--u) * 20)) scaleX(-1);
    }
    100% {
      left: 14%;
      transform: translateZ(calc(var(--u) * 20)) scaleX(1);
    }
  }

  @keyframes sway {
    from {
      transform: rotateY(-6deg);
    }
    to {
      transform: rotateY(6deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sway,
    .front {
      animation: none;
    }

    .frame-0 {
      opacity: 1;
    }

    .roamer {
      display: none;
    }

    .stage {
      transition: none;
    }
  }
</style>

<script>
  const MAX_TILT_DEGREES = 7;
  const allowsMotion = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const scene of document.querySelectorAll<HTMLElement>('.diorama')) {
    const stages = scene.querySelectorAll<HTMLElement>('[data-tilt]');
    if (!allowsMotion) continue;

    scene.addEventListener('pointermove', (event) => {
      const box = scene.getBoundingClientRect();
      const across = (event.clientX - box.left) / box.width - 0.5;
      const down = (event.clientY - box.top) / box.height - 0.5;
      for (const stage of stages) {
        stage.style.setProperty('--ry', `${across * MAX_TILT_DEGREES}deg`);
        stage.style.setProperty('--rx', `${down * -MAX_TILT_DEGREES}deg`);
      }
    });
    scene.addEventListener('pointerleave', () => {
      for (const stage of stages) {
        stage.style.removeProperty('--ry');
        stage.style.removeProperty('--rx');
      }
    });
  }
</script>
