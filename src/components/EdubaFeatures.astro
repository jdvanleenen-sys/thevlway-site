---
const shared = [
  { title: 'One set of files', line: 'The notes, price book and quote live in one place. Nobody has to ask which copy is current.' },
  { title: 'One chat', line: 'Several people can work in the same chat with the agent and see what the others asked for.' },
  { title: 'One set of rules', line: 'Put your rules in the room folder once. Every new chat follows them.' },
  { title: 'You pick who is in', line: 'Give someone a seat to work, or let them read only. A private room opens only for people you add.' },
];

const setups = [
  { title: 'Build one thing together', line: 'One shared set of files and as many chats as the job needs. Use it for a quote, a manual or a hiring package.' },
  { title: 'Each person on their own', line: 'Everyone gets their own desk and private chats. This is how the lessons run.' },
  { title: 'A fresh start every time', line: 'Every report, deck or client gets a new desk, so one job never mixes with the next.' },
];
---

<section class="container block">
  <h2>What changes when the crew shares a room</h2>
  <ul class="grid four">
    {
      shared.map((item) => (
        <li class="card">
          <h3>{item.title}</h3>
          <p>{item.line}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="container block">
  <h2>Set up the room for the job</h2>
  <ul class="grid three">
    {
      setups.map((item) => (
        <li class="card">
          <h3>{item.title}</h3>
          <p>{item.line}</p>
        </li>
      ))
    }
  </ul>
  <p class="teacher">
    <strong>I am in the building too.</strong> I can join your chat, read what you built and help you
    fix it.
  </p>
</section>

<style>
  .block {
    padding-top: var(--space-6);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .card {
    padding: var(--space-4);
    background: var(--white);
    border: 2px solid var(--navy);
    border-top: 6px solid var(--edubaware);
  }

  h3 {
    margin-bottom: var(--space-2);
    color: var(--edubaware);
  }

  .card p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  .teacher {
    margin: var(--space-4) 0 0;
    padding: var(--space-4);
    background: var(--edubaware);
    color: var(--white);
  }

  @media (max-width: 980px) {
    .four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .three {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 620px) {
    .four {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
