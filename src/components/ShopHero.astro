---
import AffiliateLink from './AffiliateLink.astro';
import ShopScene from './ShopScene.astro';
import {
  EDUBAWARE_FOUNDING_SEATS_START,
  EDUBAWARE_FREE_URL,
  EDUBAWARE_PAGE_URL,
  EDUBAWARE_PRICE,
  EDUBAWARE_REFUND_DAYS,
  ICM_PLAIN,
  TEAMS_PATH,
  TEAMS_PRICE,
} from '../consts';

const bipSayings = [
  'Quotes are sent, Boss. Probably.',
  'I filed the invoices. Somewhere.',
  'I double-checked it. Once.',
  'Your 2:00 is at 3:00. Or 1:00.',
  'I rounded the estimate. Up.',
  'The customer said yes. I think.',
  'Found the receipt. Lost the job.',
  'Boss, what is a permit?',
];
---

<section class="shop-wrap hero">
  <div class="intro">
    <p class="eyebrow">For people who aren't technical and have office work piling up behind the job</p>
    <h1>Quotes, invoices and follow-ups shouldn't take your evenings.</h1>
    <p class="lede">
      Pick one task you repeat every week. In EdubaWare, a website where people and AI work in the
      same chat, an AI coach and I help you build it. The goal: that task runs in steps, checks itself and hands it
      to you to sign off. I have been a teacher for over 24 years, and I join your chat when you need
      a person.
    </p>
  </div>

  <div class="scene">
    <ShopScene
      name="hero"
      alt="A pixel-art trades shop at night. Paperwork is piled on the workbench and spilling across the floor. A tired owner in a work shirt listens to Bip the robot under a sign reading days since Bip guessed: 0. Bit carries a card toward the classroom door."
    >
      <img class="walker" src="/shop/bit-walk.png" alt="" width="40" height="56" />
    </ShopScene>
    <span class="bubble" aria-hidden="true" data-sayings={JSON.stringify(bipSayings)}>{bipSayings[0]}</span>
  </div>

  <div class="doors">
    <div class="door">
      <p class="door-name">Free: learn the method</p>
      <p class="paid-line"><strong>What you get:</strong></p>
      <ul>
        <li>Clief Notes, a free AI community on Skool, an online community website</li>
        <li>The ICM Principles by Jake Van Clief</li>
        <li>{ICM_PLAIN}</li>
      </ul>
      <AffiliateLink compact />
    </div>
    <div class="door paid">
      <p class="door-name">The school: {EDUBAWARE_PRICE} per person, per month</p>
      <p class="paid-line"><strong>What you get:</strong></p>
      <ul>
        <li>Your own workspace with an AI coach</li>
        <li>Me in the same chat when you get stuck</li>
        <li>One fix from me on your work each week</li>
        <li>Four lessons open now, and the last three lessons as I finish them with the first group</li>
      </ul>
      <a class="button button-secondary door-button" href={EDUBAWARE_PAGE_URL}>See the EdubaWare school</a>
      <p class="door-note">
        {EDUBAWARE_FOUNDING_SEATS_START} founding seats, by invitation. The price will rise for later
        members. Cancel any time. Full refund within {EDUBAWARE_REFUND_DAYS} days of your first payment.
        Want to try it first? <a href={EDUBAWARE_FREE_URL}>Email the word FREE</a> for two free school lessons.
      </p>
    </div>
    <div class="door paid">
      <p class="door-name">For teams: {TEAMS_PRICE} per seat, per month</p>
      <p class="paid-line"><strong>What you get:</strong></p>
      <ul>
        <li>One shared room for each job, with your people and the AI in the same chat</li>
        <li>Three built templates included: earnings report, mini CIM and marketing video plan</li>
        <li>A template can show what's in, what's missing and who does what next</li>
      </ul>
      <a class="button button-secondary door-button" href={TEAMS_PATH}>See AI the vL Way for Teams</a>
      <p class="door-note">Custom setup and new templates are priced after we look at the job.</p>
    </div>
  </div>
</section>

<style>
  .shop-wrap {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: var(--space-7);
    padding-right: var(--space-7);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-7);
    align-items: center;
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--cognac-dark);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .lede {
    font-size: 1.15rem;
  }

  .doors {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    align-items: start;
  }

  /* Each door shares the same five rows, so the three buttons sit on one line. */
  .door {
    display: grid;
    grid-row: span 5;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: subgrid;
    row-gap: 0;
    min-width: 0;
    padding-top: var(--space-3);
    border-top: 2px solid var(--navy);
  }

  /* The free door's button and disclosure join the shared rows, so all 3 buttons and notes line up. */
  .door > :global(.affiliate) {
    display: contents;
  }

  /* Each button sits centered over the note below it. */
  .door > .button,
  .door > :global(.affiliate) > :global(.button) {
    align-self: end;
    justify-self: center;
  }

  .door-name {
    margin-bottom: var(--space-1);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .paid {
    border-top-color: var(--edubaware);
  }

  .paid .door-name {
    color: var(--edubaware);
  }

  .paid .button {
    border-color: var(--edubaware);
    background: var(--edubaware);
    color: var(--white);
  }

  .paid .button:hover {
    border-color: var(--edubaware-dark);
    background: var(--edubaware-dark);
  }

  .paid-line {
    margin-bottom: var(--space-2);
    font-size: 1rem;
  }

  .door .button {
    text-align: center;
  }

  .door ul {
    margin: 0 0 var(--space-3);
    padding-left: var(--space-4);
  }

  .door li {
    margin-bottom: var(--space-1);
  }

  .door-note {
    margin: var(--space-2) 0 0;
    font-size: 0.9rem;
  }

  .scene {
    position: relative;
    aspect-ratio: 240 / 135;
    overflow: hidden;
    border: 4px solid var(--navy);
    background: var(--cognac-light);
  }

  .walker {
    position: absolute;
    left: 8%;
    bottom: 10%;
    width: 4.17%;
    height: auto;
    image-rendering: pixelated;
    transform: translateZ(calc(var(--u) * 16));
    animation: walk 11s steps(44) infinite;
  }

  .bubble {
    position: absolute;
    right: 15%;
    top: 45%;
    padding: 3px 9px;
    background: var(--white);
    border: 2px solid var(--navy);
    font-size: clamp(10px, 1.1vw, 15px);
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
  }

  .bubble {
    transition: opacity 0.25s ease;
  }

  .bubble.quiet {
    opacity: 0;
  }

  @keyframes walk {
    0% {
      left: 8%;
      opacity: 0;
    }
    4%,
    92% {
      opacity: 1;
    }
    100% {
      left: 80%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .walker {
      left: 40%;
      animation: none;
    }
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      padding-top: var(--space-6);
      padding-bottom: var(--space-7);
    }

    .doors {
      grid-template-columns: minmax(0, 1fr);
    }

    .door {
      display: flex;
      flex-direction: column;
      grid-row: auto;
    }

    .door > .button,
    .door > :global(.affiliate) > :global(.button) {
      align-self: center;
    }
  }

  @media (max-width: 620px) {
    .shop-wrap {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }

    .bubble {
      right: 12%;
      padding: 1px 4px;
      border-width: 1px;
      font-size: 9px;
    }
  }
</style>

<script>
  const SHOW_MS = 3600;
  const PAUSE_MS = 1300;
  const bubble = document.querySelector<HTMLElement>('.bubble[data-sayings]');

  if (bubble && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const sayings = JSON.parse(bubble.dataset.sayings ?? '[]') as string[];
    let current = 0;

    const showNextSaying = () => {
      bubble.classList.add('quiet');
      window.setTimeout(() => {
        current = (current + 1) % sayings.length;
        bubble.textContent = sayings[current];
        bubble.classList.remove('quiet');
        window.setTimeout(showNextSaying, SHOW_MS);
      }, PAUSE_MS);
    };

    window.setTimeout(showNextSaying, SHOW_MS);
  }
</script>