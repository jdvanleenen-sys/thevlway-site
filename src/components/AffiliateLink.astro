---
import { CLIEF_NOTES_AFFILIATE_URL, CLIEF_NOTES_DISCLOSURE, ICM_PLAIN } from '../consts';

interface Props {
  fillCard?: boolean;
  compact?: boolean;
  edubawareColor?: boolean;
  defineIcm?: boolean;
}

const { fillCard = false, compact = false, edubawareColor = false, defineIcm = true } = Astro.props;
---

<div class:list={['affiliate', { 'fill-card': fillCard }]}>
  {
    !compact && (
      <p>{defineIcm && `${ICM_PLAIN} `}Learn the ICM Principles by Jake Van Clief in Clief Notes, a free AI community on Skool, an online community website.</p>
    )
  }
  {!compact && <p class="affiliate-disclosure">{CLIEF_NOTES_DISCLOSURE}</p>}
  <a
    class:list={['button door-button', edubawareColor ? 'button-edubaware' : 'button-primary']}
    href={CLIEF_NOTES_AFFILIATE_URL}
    rel="sponsored"
  >
    Join Clief Notes (affiliate link)
  </a>
  {compact && <p class="affiliate-disclosure below">{CLIEF_NOTES_DISCLOSURE}</p>}
</div>

<style>
  .affiliate {
    max-width: 32em;
  }

  .affiliate-disclosure {
    margin-bottom: var(--space-2);
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
  }

  .affiliate-disclosure.below {
    margin: var(--space-2) 0 0;
    font-size: 0.9rem;
  }

  .button {
    text-align: center;
  }

  .button-primary {
    background: var(--cognac-dark);
  }

  .button-primary:hover {
    background: color-mix(in srgb, var(--cognac-dark) 80%, black);
    color: var(--white);
  }

  .fill-card {
    display: flex;
    flex: 1;
    flex-direction: column;
    max-width: none;
  }

  .fill-card .affiliate-disclosure {
    margin-top: auto;
  }
</style>
