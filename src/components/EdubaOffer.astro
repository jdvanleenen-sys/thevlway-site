---
import { EDUBAWARE_FOUNDING_SEATS, EDUBAWARE_PRICE, TEAMS_PATH } from '../consts';

const included = [
  'Your own workspace in EdubaWare, where an AI coach walks you through each lesson.',
  'Short lessons in plain words, for people who are not technical.',
  'Practice on one job you repeat every week, so what you build is useful at work.',
  'Me in the same chat, and one fix from me each week.',
  'New lessons as they are finished.',
  'Two or more paid seats get one private shared workspace, where your crew works in the same chat at the same time.',
];

const ready = [
  { name: 'One Job, One Page', line: 'Put your weekly job on one page.' },
  { name: 'The Fresh Chat Test', line: 'See where a new AI gets lost in a folder.' },
  { name: 'Use the Room', line: 'Find your way around your workspace and make the AI coach remember your rules.' },
  { name: 'Run a Room', line: 'Plan a shared workspace for your team.' },
];

const building = [
  { name: 'Build It to Do the Job', line: 'Turn your page into a job that runs.' },
  { name: 'Make It Check Itself', line: 'Add checks that catch mistakes.' },
  { name: 'Make It Repeat', line: 'Run it again on new work.' },
];
---

<section class="container offer" id="offer">
  <h2>Your founding seat: {EDUBAWARE_PRICE} a month</h2>
  <p class="cap">I am taking {EDUBAWARE_FOUNDING_SEATS} founding seats, so I have time to read everyone's work.</p>
  <p>Buying for a company? <a href={TEAMS_PATH}>See AI the vL Way for Teams</a>.</p>
  <div class="columns">
    <article class="panel depth-box">
      <h3>Your seat</h3>
      <ul>{included.map((item) => <li>{item}</li>)}</ul>
    </article>
    <article class="panel depth-box">
      <h3>Ready now</h3>
      <ul>{ready.map((lesson) => <li><strong>{lesson.name}.</strong> {lesson.line}</li>)}</ul>
      <h3>Being built</h3>
      <ul>{building.map((lesson) => <li><strong>{lesson.name}.</strong> {lesson.line}</li>)}</ul>
      <p class="note">These three lessons finish your weekly job. They are not open yet. I am building them with the first group, so your real work helps shape them.</p>
    </article>
  </div>
</section>

<style>
  .offer {
    padding-top: var(--space-7);
    padding-bottom: var(--space-4);
  }

  .cap {
    font-weight: 700;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .panel {
    min-width: 0;
    padding: var(--space-4);
    background: var(--white);
    border: 2px solid var(--navy);
    border-top: 6px solid var(--edubaware);
    font-size: 1rem;
    line-height: 1.5;
  }

  h3 {
    margin-bottom: var(--space-2);
    color: var(--edubaware);
  }

  ul {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  li {
    margin-bottom: var(--space-2);
  }

  .note {
    margin: 0;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
