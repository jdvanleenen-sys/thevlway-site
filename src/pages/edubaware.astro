---
import Base from '../layouts/Base.astro';
import CrewRoomDemo from '../components/CrewRoomDemo.astro';
import EdubaFeatures from '../components/EdubaFeatures.astro';
import EdubaHero from '../components/EdubaHero.astro';
import EdubaTerms from '../components/EdubaTerms.astro';
import { EDUBAWARE_PRICE, OWNER_NAME } from '../consts';
---

<Base
  title="EdubaWare access"
  description={`Put your crew in one shared room with an AI agent on EdubaWare with ${OWNER_NAME}. ${EDUBAWARE_PRICE} per person per month, by invitation.`}
>
  <EdubaHero />
  <CrewRoomDemo />
  <EdubaFeatures />
  <EdubaTerms />
</Base>