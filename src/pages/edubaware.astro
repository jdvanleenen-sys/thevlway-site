---
import Base from '../layouts/Base.astro';
import EdubaFaq from '../components/EdubaFaq.astro';
import EdubaHero from '../components/EdubaHero.astro';
import EdubaMethod from '../components/EdubaMethod.astro';
import EdubaOffer from '../components/EdubaOffer.astro';
import EdubaPaths from '../components/EdubaPaths.astro';
import EdubaProblem from '../components/EdubaProblem.astro';
import EdubaTerms from '../components/EdubaTerms.astro';
import EdubaWeek from '../components/EdubaWeek.astro';
import { EDUBAWARE_FOUNDING_SEATS, EDUBAWARE_PRICE, OWNER_NAME } from '../consts';
---

<Base
  title="Understand ICM or build it with me"
  description={`ICM Principles by Jake Van Clief. Understand it free or build it with ${OWNER_NAME} in your chat. ${EDUBAWARE_FOUNDING_SEATS} founding seats at ${EDUBAWARE_PRICE} a month.`}
>
  <div class="eduba-page">
    <EdubaHero />
    <EdubaProblem />
    <EdubaPaths />
    <EdubaWeek />
    <EdubaMethod />
    <EdubaOffer />
    <EdubaTerms />
    <EdubaFaq />
  </div>
</Base>

<style is:global>
  /* This page carries EdubaWare's burgundy, so its boxes and links match the buttons. */
  .eduba-page {
    --depth-edge: var(--edubaware-dark);
  }

  .eduba-page .depth-box.depth-box {
    border-color: var(--edubaware);
  }

  .eduba-page a {
    text-decoration-color: var(--edubaware);
  }

  .eduba-page a:not(.button):hover {
    color: var(--edubaware);
  }

  .eduba-page a:focus-visible {
    outline-color: var(--edubaware);
  }
</style>
