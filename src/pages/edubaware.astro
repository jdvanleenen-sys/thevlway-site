---
import Base from '../layouts/Base.astro';
import EdubaFaq from '../components/EdubaFaq.astro';
import PageWalkers from '../components/PageWalkers.astro';
import EdubaHero from '../components/EdubaHero.astro';
import EdubaMethod from '../components/EdubaMethod.astro';
import EdubaOffer from '../components/EdubaOffer.astro';
import EdubaPaths from '../components/EdubaPaths.astro';
import EdubaProblem from '../components/EdubaProblem.astro';
import EdubaTerms from '../components/EdubaTerms.astro';
import EdubaWeek from '../components/EdubaWeek.astro';
import { EDUBAWARE_FOUNDING_SEATS, EDUBAWARE_FOUNDING_SEATS_START, EDUBAWARE_PRICE, OWNER_NAME, SITE_NAME } from '../consts';
import { EDUBAWARE_FAQ } from '../lib/edubaFaq';
import { EDUBAWARE_SHARE_ALT, EDUBAWARE_SHARE_IMAGE, faqSchema } from '../lib/seo';

const siteUrl = new URL('/', Astro.site).href;
const pageUrl = `${siteUrl}edubaware/`;
const school = {
  '@type': 'Service',
  '@id': `${pageUrl}#school`,
  name: `${SITE_NAME} school on EdubaWare`,
  serviceType: 'AI training on your own weekly office job',
  description: 'Learn ICM Principles by Jake Van Clief on one real weekly job, free with an AI coach or with a teacher in the same chat.',
  url: pageUrl,
  provider: { '@id': `${siteUrl}#org` },
  offers: [
    {
      '@type': 'Offer',
      name: 'Try it free',
      price: '0',
      priceCurrency: 'USD',
      url: pageUrl,
    },
    {
      '@type': 'Offer',
      name: 'Build it with me: founding seat',
      price: '30',
      priceCurrency: 'USD',
      url: pageUrl,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '30',
        priceCurrency: 'USD',
        unitText: 'per person, per month',
      },
    },
  ],
};
---

<Base
  title="Learn ICM With a Teacher in Your Chat"
  description={`Bring one weekly job. Try two free lessons, or build it with ${OWNER_NAME} in the same chat. ${EDUBAWARE_FOUNDING_SEATS_START} founding seats at ${EDUBAWARE_PRICE} a month.`}
  image={EDUBAWARE_SHARE_IMAGE}
  imageAlt={EDUBAWARE_SHARE_ALT}
  schema={[school, faqSchema(pageUrl, EDUBAWARE_FAQ)]}
>
  <div class="eduba-page">
    <EdubaHero />
    <EdubaProblem />
    <EdubaPaths />
    <EdubaWeek />
    <EdubaMethod />
    <EdubaOffer />
    <EdubaTerms />
    <EdubaFaq />
    <PageWalkers sheet="/shop/cast-walk.png" headings=".eduba-page > section h2" maxLanes={4} />
  </div>
</Base>

<style is:global>
  /* This page carries EdubaWare's burgundy, so its boxes and links match the buttons. */
  .eduba-page {
    --depth-edge: var(--edubaware-dark);
    position: relative;
  }

  .eduba-page .depth-box.depth-box {
    border-color: var(--edubaware);
  }

  .eduba-page a {
    text-decoration-color: var(--edubaware);
  }

  .eduba-page a:not(.button):hover {
    color: var(--edubaware);
  }

  .eduba-page a:focus-visible {
    outline-color: var(--edubaware);
  }
</style>
