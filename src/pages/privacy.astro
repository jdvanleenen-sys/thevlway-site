---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, OWNER_LOCATION, OWNER_NAME, SITE_NAME } from '../consts';

const EFFECTIVE_DATE = 'November 23, 2026';
const contactHref = `mailto:${CONTACT_EMAIL}`;

const collected = [
  'Your name, email address and business name, when you email me or buy a seat.',
  'Your billing address and payment details, which you enter on Stripe. I can see the last 4 digits and brand of your card. I never see the full number.',
  'Your payment history, such as invoices, receipts, refunds and subscription status.',
  'What you type and upload in your EdubaWare workspace, including chats with the AI coach and the files you build.',
  'Company files and information you give me for a template, custom build, training or ongoing help.',
  'Anything you choose to tell me by email.',
];

const uses = [
  'Send your invitation and give you access to EdubaWare.',
  'Teach, check your work and answer your questions.',
  'Build and support the templates and tools your company hires me to make.',
  'Charge you, send receipts and handle refunds.',
  'Keep the records the law requires, such as tax records.',
];

const providers = [
  { name: 'Stripe', job: 'processes payments, receipts and invoices, and helps prevent fraud.' },
  { name: 'Eduba', job: 'runs the EdubaWare platform and stores your workspace.' },
  { name: 'AI model providers', job: 'process what you send to the AI coach so it can reply.' },
  { name: 'GitHub', job: 'hosts this website and may log basic visit data, such as IP addresses.' },
  { name: 'Google Fonts', job: 'delivers this site\'s font, which sends your IP address to Google.' },
  { name: 'YouTube', job: 'plays the videos embedded in blog posts, which sends your IP address to Google.' },
  { name: 'Email providers', job: 'carry and store messages you send me.' },
];
---

<Base title="Privacy policy" description={`How ${SITE_NAME} collects, uses, shares and stores your personal information.`}>
  <div class="container policy">
    <header class="head">
      <p class="eyebrow">Effective {EFFECTIVE_DATE}</p>
      <h1>Privacy policy</h1>
      <p class="lede">
        This policy covers thevlway.com, free and paid EdubaWare seats, and company work from {OWNER_NAME} of {SITE_NAME},
        based in {OWNER_LOCATION}. I am responsible for the personal information described here.
      </p>
    </header>

    <div class="panels two">
      <section class="panel depth-box">
        <h2>What I collect</h2>
        <ul>{collected.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section class="panel depth-box">
        <h2>How I use it</h2>
        <ul>{uses.map((item) => <li>{item}</li>)}</ul>
        <p class="strong">I do not sell your personal information.</p>
      </section>
    </div>

    <div class="panels">
      <section class="panel workspace depth-box">
        <h2>Who can see your workspace</h2>
        <p>
          I can see your EdubaWare workspace and chats so I can teach and check your work. Other managers
          of the same EdubaWare organization can also see them. If your employer bought your seat, its
          managers may be able to see your work too. If you work in a shared workspace, everyone in that
          workspace can read and download every file in it. Do not put private customer, financial or health
          information in your workspace unless you are allowed to.
        </p>
      </section>
    </div>

    <div class="panels">
      <section class="panel depth-box">
        <h2>Who I share it with</h2>
        <p>I share only what these providers need to do their job:</p>
        <ul class="providers">
          {
            providers.map((provider) => (
              <li>
                <strong>{provider.name}</strong> {provider.job}
              </li>
            ))
          }
        </ul>
        <p>If your company connects other tools to a shared workspace, the AI coach can send them information from that workspace. Your company chooses those tools.</p>
        <p>I may also disclose information when the law requires it.</p>
      </section>
    </div>

    <div class="panels three">
      <section class="panel depth-box">
        <h2>Where it is stored</h2>
        <p>
          These providers may store or process your information outside Canada, including in the United
          States, where it may be subject to the laws of that country.
        </p>
      </section>
      <section class="panel depth-box">
        <h2>How long I keep it</h2>
        <p>
          I keep your account information while you have a seat and for as long as I need it after that
          to answer questions or resolve a dispute. Billing records are kept for at least 6 years for tax
          purposes. I keep company files only as long as I need them for the work you hired me to do, or
          until you ask me to delete them, unless the law requires me to keep them.
        </p>
      </section>
      <section class="panel depth-box">
        <h2>Cookies</h2>
        <p>
          This site does not use advertising or analytics cookies. Stripe and EdubaWare use their own
          cookies to keep payments and sign-ins working. Blog videos use YouTube's privacy-enhanced player,
          which may store data in your browser when you play a video.
        </p>
      </section>
    </div>

    <div class="panels two">
      <section class="panel depth-box">
        <h2>Your choices</h2>
        <p>
          You can ask to see, correct or delete your personal information, or withdraw your consent, by
          emailing <a href={contactHref}>{CONTACT_EMAIL}</a>. Some records must be kept by law. If you are
          not satisfied with my answer, you can contact the Office of the Information and Privacy
          Commissioner of Alberta.
        </p>
      </section>
      <section class="panel depth-box">
        <h2>Changes and contact</h2>
        <p>
          If this policy changes, I will update the date at the top. Questions go
          to <a href={contactHref}>{CONTACT_EMAIL}</a>.
        </p>
      </section>
    </div>
  </div>
</Base>

<style>
  .policy {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-7);
  }

  .head {
    max-width: 46em;
    margin-bottom: var(--space-3);
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--cognac-dark);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.2rem, 4.4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .lede {
    margin-bottom: 0;
    font-size: 1.1rem;
  }

  .panels {
    display: grid;
    gap: var(--space-4);
  }

  .two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .panel {
    min-width: 0;
    padding: var(--space-4);
    background: var(--white);
    border: 2px solid var(--navy);
    border-top: 6px solid var(--navy);
    font-size: 1rem;
    line-height: 1.55;
  }

  .workspace {
    border-top-color: var(--edubaware);
  }

  .workspace h2 {
    color: var(--edubaware);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: 1.35rem;
  }

  ul {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
  }

  li {
    margin-bottom: var(--space-2);
  }

  .providers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-6);
  }

  .panel p:last-child,
  .panel ul:last-child {
    margin-bottom: 0;
  }

  .strong {
    font-weight: 700;
  }

  a {
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .two,
    .three,
    .providers {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>