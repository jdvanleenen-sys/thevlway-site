---
import Base from '../layouts/Base.astro';
import ShopHero from '../components/ShopHero.astro';
import ShopRooms from '../components/ShopRooms.astro';
import TwoDoors from '../components/TwoDoors.astro';
---

<Base title="AI for Your Office Work">
  <ShopHero />
  <ShopRooms />
  <section class="start">
    <h2>Two ways to start</h2>
    <TwoDoors />
  </section>
</Base>

<style>
  .start {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-7) 0;
  }

  @media (max-width: 620px) {
    .start {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
  }
</style>
