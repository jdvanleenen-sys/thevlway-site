---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatPostDate, getPublishedPosts, type BlogPost } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="container reading page">
    <h1>{post.data.title}</h1>
    <p class="muted">
      {formatPostDate(post.data.pubDate)}
      {post.data.updatedDate && <span> · Updated {formatPostDate(post.data.updatedDate)}</span>}
    </p>
    <Content />
  </article>
</Base>

<style>
  .page {
    padding-top: var(--space-7);
  }
</style>
