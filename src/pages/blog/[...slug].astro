---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostBody from '../../components/PostBody.astro';
import PostCard from '../../components/PostCard.astro';
import TwoDoors from '../../components/TwoDoors.astro';
import { formatPostDate, getPublishedPosts, type BlogPost } from '../../lib/posts';

const MORE_POSTS = 3;

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      morePosts: Array.from({ length: Math.min(3, posts.length - 1) }, (_, step) => posts[(index + step + 1) % posts.length]),
    },
  }));
}

interface Props {
  post: BlogPost;
  morePosts: BlogPost[];
}

const { post, morePosts } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);
---

<Base title={post.data.title} description={post.data.description}>
  <div class="container post">
    <header class="post-head">
      <a class="back" href="/blog/">Back to the blog</a>
      <h1>{post.data.title}</h1>
      <p class="date">
        {formatPostDate(post.data.pubDate)}
        {post.data.updatedDate && <span> · Updated {formatPostDate(post.data.updatedDate)}</span>}
      </p>
    </header>
    <div class:list={['layout', { single: sections.length === 0 }]}>
      <article><PostBody><Content /></PostBody></article>
      {
        sections.length > 0 && (
          <aside aria-label="In this post">
            <p class="aside-title">In this post</p>
            <ol>
              {sections.map((section) => (
                <li>
                  <a href={`#${section.slug}`}>{section.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
  </div>

  <section class="more">
    <div class="container">
      <h2>Keep reading</h2>
      <ul class="grid" data-count={MORE_POSTS}>
        {morePosts.map((item) => (
          <li>
            <PostCard post={item} heading="h3" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container start">
    <h2>2 ways to start</h2>
    <TwoDoors />
  </section>
</Base>

<style>
  .post {
    padding-top: var(--space-6);
    padding-bottom: var(--space-7);
  }

  .post-head {
    max-width: 820px;
    margin-bottom: var(--space-5);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: var(--space-2);
    color: var(--cognac-dark);
    font-weight: 700;
  }

  h1 {
    font-size: clamp(1.9rem, 3.8vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .date {
    margin: 0;
    color: var(--warm-grey);
    font-size: 0.95rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: var(--space-7);
    align-items: start;
  }

  .layout.single {
    grid-template-columns: minmax(0, 720px);
  }

  article {
    min-width: 0;
  }

  aside {
    position: sticky;
    top: var(--space-4);
    max-height: calc(100vh - var(--space-6));
    padding: var(--space-4);
    overflow-y: auto;
    background: var(--white);
    border: 2px solid var(--navy);
    border-top: 6px solid var(--cognac-dark);
  }

  .aside-title {
    margin-bottom: var(--space-2);
    font-weight: 700;
  }

  aside ol {
    margin: 0;
    padding-left: var(--space-4);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  aside li {
    margin-bottom: var(--space-2);
  }

  .more {
    padding: var(--space-7) 0;
    background: var(--cream);
  }

  .more h2 {
    margin-bottom: var(--space-4);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    min-width: 0;
  }

  .start {
    padding-top: var(--space-7);
  }

  @media (max-width: 980px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    aside {
      position: static;
      grid-row: 1;
      max-height: none;
    }

    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>