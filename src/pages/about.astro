---
import Base from '../layouts/Base.astro';
import AboutHero from '../components/AboutHero.astro';
import AboutSubjects from '../components/AboutSubjects.astro';
import AboutWhy from '../components/AboutWhy.astro';
import TwoDoors from '../components/TwoDoors.astro';
import { OWNER_NAME, SITE_NAME } from '../consts';

// Claims come from rows marked PUBLIC in Jeff-HQ/10 Ventures/icm-consulting/next-yes/me.md, Jeff's
// own Office line, and the Masters line on the EdubaWare page. Check there before adding one.
const siteUrl = new URL('/', Astro.site).href;
const profile = {
  '@type': 'ProfilePage',
  '@id': `${siteUrl}about/#profile`,
  url: `${siteUrl}about/`,
  mainEntity: { '@id': `${siteUrl}#owner` },
};
---

<Base
  title={`About ${OWNER_NAME}`}
  description={`${OWNER_NAME} runs ${SITE_NAME} and teaches trade contractors to build simple AI systems.`}
  schema={[profile]}
>
  <AboutHero />
  <AboutSubjects />
  <AboutWhy />
  <section class="container start">
    <h2>2 ways to start</h2>
    <TwoDoors />
  </section>
</Base>

<style>
  .start {
    padding-top: var(--space-7);
  }
</style>