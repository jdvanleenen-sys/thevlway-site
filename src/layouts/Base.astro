---
import '../styles/global.css';
import DepthBoxes from '../components/DepthBoxes.astro';
import {
  NAV_LINKS,
  OWNER_LOCATION,
  OWNER_NAME,
  SITE_DESCRIPTION,
  SITE_NAME,
  YOUTUBE_URL,
} from '../consts';
import {
  buildPageTitle,
  DEFAULT_SHARE_ALT,
  DEFAULT_SHARE_IMAGE,
  pageGraph,
  serializeSchema,
  type Schema,
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  schema?: Schema[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = DEFAULT_SHARE_IMAGE,
  imageAlt = DEFAULT_SHARE_ALT,
  ogType = 'website',
  schema = [],
  publishedTime,
  modifiedTime,
} = Astro.props;
const pageTitle = buildPageTitle(title);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site).href;
const year = new Date().getFullYear();

// Tells search engines the site and the channel are one entity run by one person.
const siteUrl = new URL('/', Astro.site).href;
const entityGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#org`,
      name: SITE_NAME,
      url: siteUrl,
      description: SITE_DESCRIPTION,
      logo: new URL('/favicon.svg', Astro.site).href,
      founder: { '@id': `${siteUrl}#owner` },
      sameAs: [YOUTUBE_URL],
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#owner`,
      name: OWNER_NAME,
      url: new URL('/about/', Astro.site).href,
      description: "School teacher for 24 years, now a home building executive, and one of Jake Van Clief's 7 Masters of ICM.",
      knowsAbout: ['Interpretable Context Methodology', 'AI systems for small business', 'Teaching adults to use AI'],
      homeLocation: OWNER_LOCATION,
      worksFor: { '@id': `${siteUrl}#org` },
      sameAs: [YOUTUBE_URL],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#site`,
      name: SITE_NAME,
      url: siteUrl,
      publisher: { '@id': `${siteUrl}#org` },
      inLanguage: 'en-CA',
    },
    ...pageGraph({
      siteUrl,
      pageUrl: canonicalUrl.href,
      path: Astro.url.pathname,
      title: title ?? SITE_NAME,
      description,
      imageUrl,
    }),
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="Site guide for AI tools" href="/llms.txt" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {ogType === 'article' && <meta property="article:author" content={OWNER_NAME} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={serializeSchema(entityGraph)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/">
          <img src="/favicon.svg" alt="" width="32" height="32" />
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label="Main">
          {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>{SITE_NAME} by {OWNER_NAME}. &copy; {year}</p>
        <p>
          <a href="/edubaware/">EdubaWare school</a>
          <span aria-hidden="true"> · </span>
          <a href="/teams/">For teams</a>
          <span aria-hidden="true"> · </span>
          <a href={YOUTUBE_URL}>YouTube</a>
          <span aria-hidden="true"> · </span>
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>
    <DepthBoxes />
    <script>
      import { addSoftHyphens } from '../lib/softHyphens';

      addSoftHyphens(document, 'main p, main li');
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid rgba(107, 101, 96, 0.3);
    background: var(--warm-white);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 700;
    text-decoration: none;
    color: var(--navy);
  }

  nav {
    display: flex;
    gap: var(--space-5);
  }

  nav a {
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  /* 4 links only fit on a phone when the site name is left to the logo and screen readers. */
  @media (max-width: 560px) {
    .wordmark span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    nav {
      gap: var(--space-4);
    }
  }

  .site-footer {
    margin-top: var(--space-8);
    padding: var(--space-6) 0;
    background: var(--navy);
    color: var(--cream);
    font-size: 0.9rem;
  }

  .site-footer a {
    color: var(--cream);
  }

  .footer-inner p {
    margin: 0 0 var(--space-2);
  }
</style>
